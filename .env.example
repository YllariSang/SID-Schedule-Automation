# Local dashboard port
PORT=4173

# Optional terminal watcher interval. The CLI flag takes precedence.
WATCH_INTERVAL_SECONDS=300

# Device backend: adb (the default for a USB/network device) or waydroid.
# WATCH_DEVICE=adb

# Optional when more than one non-Waydroid ADB device is connected.
# ADB_SERIAL=192.0.2.10:5555

# Optional generic webhook. A JSON POST is sent only when a schedule changes.
# WEBHOOK_URL=https://example.com/your-webhook

# Request timeout in milliseconds.
REQUEST_TIMEOUT_MS=15000
